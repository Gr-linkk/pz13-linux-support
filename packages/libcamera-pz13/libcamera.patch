+void SoftwareIsp::focusSample(uint64_t timestamp, double score, double luma, double scene)
+{
+	if (!af_) return;
+	timespec now;
+	clock_gettime(CLOCK_MONOTONIC, &now);
+	auto before = af_->state();
+	af_->sample(timestamp / 1e9, now.tv_sec + now.tv_nsec / 1e9, score, luma, scene);
+	if (before != af_->state())
+		LOG(SoftwareIsp, Info) << "PZ13 autofocus state " << af_->state();
+}
