+void SoftwareIsp::applyFocusControls(const ControlList &controls)
+{
+	if (!af_) return;
+	if (auto mode = controls.get(controls::AfMode)) af_->mode(*mode);
+	if (af_->mode() == controls::AfModeAuto) {
+		if (auto trigger = controls.get(controls::AfTrigger)) {
+			if (*trigger == controls::AfTriggerStart) af_->trigger();
+			else if (*trigger == controls::AfTriggerCancel) af_->cancel();
+		}
+	} else if (auto pause = controls.get(controls::AfPause)) {
+		if (*pause == controls::AfPauseImmediate) af_->pause(true);
+		else if (*pause == controls::AfPauseResume) af_->pause(false);
+	}
+}
